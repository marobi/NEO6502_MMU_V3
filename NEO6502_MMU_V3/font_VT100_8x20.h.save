// VT100_80x24_8x20.h
// Adafruit GFX font for 640x480 / 80x24 terminal display.
// Generated from the DEC VT100 23-018E2 character generator ROM.
//
// Pipeline:
//   1. VT100 ROM 8x10 glyph rows
//   2. VT100-like horizontal dot-stretch to 10x10
//   3. coverage downsample from 10 columns to 8 columns
//   4. vertical double from 10 rows to 20 rows
//
// This is a practical 640x480 compromise:
//   real VT100 80-column cell is effectively 10 dots wide;
//   640x480 80-column output requires an 8-pixel cell.
//
// Geometry:
//   640 / 8  = 80 columns
//   480 / 20 = 24 rows
//
// Usage:
//   #include "VT100_80x24_8x20.h"
//   display.setFont(&VT100_80x24_8x20);
//   display.setTextSize(1);
//   display.setCursor(0, 19);

#ifndef VT100_80X24_8X20__H
#define VT100_80X24_8X20__H

